<Window x:Class="kuznecov.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:kuznecov"
        mc:Ignorable="d"
        Title="Kuznecov_autoservis" Height="450" Width="800" FontFamily="Tw Cen MT" Icon="/image/service_logo.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        <Image Source= "image\service_logo.png" HorizontalAlignment="Left"></Image>
        <TextBlock Text = "Услуги авторсервиса" FontSize = "30" HorizontalAlignment="Center" VerticalAlignment="Center"></TextBlock>
        <Frame Grid.Row="1" Name="MainFrame" ContentRendered="MainFrame_ContentRendered" NavigationUIVisibility="Hidden"></Frame>
        <Button Content="Назад" Name="BntBack" Width="175" Height="30" HorizontalAlignment="Right" Margin="5" Click="BntBack_Click"></Button>
    </Grid>
</Window>
